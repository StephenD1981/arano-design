{
  "name": "@arano/design",
  "version": "1.0.0",
  "description": "The ARANO look and feel: colour tokens, the dark theme, a Tailwind preset, fonts and the brand mark, shared by every ARANO product and the website.",
  "license": "UNLICENSED",
  "author": "ARANO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephenD1981/arano-design.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "fonts",
    "brand",
    "DESIGN-RULES.md"
  ],
  "exports": {
    "./tokens": {
      "import": {
        "types": "./dist/tokens/index.d.ts",
        "default": "./dist/tokens/index.js"
      },
      "require": {
        "types": "./dist/tokens/index.d.cts",
        "default": "./dist/tokens/index.cjs"
      }
    },
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset/index.d.ts",
        "default": "./dist/tailwind-preset/index.js"
      },
      "require": {
        "types": "./dist/tailwind-preset/index.d.cts",
        "default": "./dist/tailwind-preset/index.cjs"
      }
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts": {
      "import": {
        "types": "./dist/fonts/index.d.ts",
        "default": "./dist/fonts/index.js"
      },
      "require": {
        "types": "./dist/fonts/index.d.cts",
        "default": "./dist/fonts/index.cjs"
      }
    },
    "./fonts/*": "./fonts/*",
    "./brand": {
      "import": {
        "types": "./dist/brand/index.d.ts",
        "default": "./dist/brand/index.js"
      },
      "require": {
        "types": "./dist/brand/index.d.cts",
        "default": "./dist/brand/index.cjs"
      }
    },
    "./brand/*": "./brand/*",
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/build-assets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:fixtures": "vitest run --project fixtures",
    "version-packages": "changeset version",
    "changeset": "changeset",
    "prepublishOnly": "node -e \"if (process.env.GITHUB_ACTIONS !== 'true') { console.error('@arano/design is published from CI only: see the README, Releasing.'); process.exit(1) }\""
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "10.13.0",
    "postcss": "8.5.30",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.1.16",
    "tailwindcss-v3": "npm:tailwindcss@3.4.19",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
